# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FLUTTERWAVE_PUBLIC_KEY: Required for card/mobile money standard checkout
FLW_PUBLIC_KEY=FLWPBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
# FLUTTERWAVE_SECRET_KEY: Required for initiating payment and verification APIs
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X

# STRIPE_PUBLISHABLE_KEY: Required for Stripe payment gateway publishable features
STRIPE_PUBLISHABLE_KEY=STRIPE_PUBLISHABLE_KEY_PLACEHOLDER
# STRIPE_SECRET_KEY: Required for creating secure Stripe Checkout Sessions
STRIPE_SECRET_KEY=STRIPE_SECRET_KEY_PLACEHOLDER

# TWILIO_ACCOUNT_SID: Twilio Account SID for live SMS OTP gateway
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# TWILIO_AUTH_TOKEN: Twilio Authentication Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER: Twilio virtual phone number (E.164 format)
TWILIO_PHONE_NUMBER=+18005550199
# TWILIO_VERIFY_SERVICE_SID: Optional Twilio Verify Service SID
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
