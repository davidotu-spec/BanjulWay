rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // WAYGO CLOUD FIRESTORE SECURITY RULES (GAMBIA RIDE-HAILING)
    // ---------------------------------------------------------

    // Authentication & Identity Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Role-based Access Controls
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@waygo\\.gm') ||
          request.auth.token.email.matches('(admin|ops|support).*@.*')
        ))
      );
    }

    function isDriver() {
      return isAuthenticated() && (
        request.auth.token.role == 'DRIVER' ||
        isAdmin()
      );
    }

    function isPassenger() {
      return isAuthenticated() && (
        request.auth.token.role == 'PASSENGER' ||
        isAdmin()
      );
    }

    // Trip Participant Helper
    function isTripParticipant(passengerId, driverId) {
      return isAuthenticated() && (
        request.auth.uid == passengerId ||
        request.auth.token.email == passengerId ||
        request.auth.uid == driverId ||
        request.auth.token.email == driverId ||
        isAdmin()
      );
    }

    // Validate GPS Coordinates Range
    function isValidLatLng(lat, lng) {
      return lat is number && lat >= -90.0 && lat <= 90.0 &&
             lng is number && lng >= -180.0 && lng <= 180.0;
    }

    // ---------------------------------------------------------
    // 1. ACTIVE RIDE REQUESTS (Real-time Ride Dispatch & Lifecycle)
    // ---------------------------------------------------------
    match /active_ride_requests/{requestId} {
      // Any authenticated user can read active ride requests (drivers scan vicinity, passengers watch active rides)
      allow read: if isAuthenticated();

      // Passengers or Admins can create a new ride request
      allow create: if isAuthenticated() &&
        request.resource.data.requestId != null &&
        request.resource.data.passengerId != null &&
        isValidLatLng(request.resource.data.pickupLat, request.resource.data.pickupLng) &&
        isValidLatLng(request.resource.data.dropoffLat, request.resource.data.dropoffLng) &&
        request.resource.data.fareGmd is int &&
        request.resource.data.fareGmd > 0 &&
        (request.resource.data.status == 'REQUESTED' || request.resource.data.status == 'SEARCHING');

      // Update allowed by the requesting passenger, the assigned driver, or admin
      allow update: if isAuthenticated() && (
        // Passenger updating preferences or cancelling
        request.auth.uid == resource.data.passengerId ||
        request.auth.token.email == resource.data.passengerId ||
        // Driver accepting or updating ride status
        request.auth.uid == request.resource.data.driverId ||
        request.auth.token.email == request.resource.data.driverId ||
        request.auth.uid == resource.data.driverId ||
        // Administrator override
        isAdmin()
      );

      // Delete allowed only by administrator or the owner passenger before acceptance
      allow delete: if isAdmin() || (
        (request.auth.uid == resource.data.passengerId || request.auth.token.email == resource.data.passengerId) &&
        (resource.data.status == 'REQUESTED' || resource.data.status == 'SEARCHING' || resource.data.status == 'CANCELLED')
      );
    }

    // ---------------------------------------------------------
    // 2. DRIVER LOCATIONS (Real-time Telematics & Fleet Tracking)
    // ---------------------------------------------------------
    match /driver_locations/{driverId} {
      // Authenticated users can view live driver locations for dispatch and map display
      allow read: if isAuthenticated();

      // Only the authenticated driver or admin can update their live coordinates
      allow create, update: if isAuthenticated() && (
        request.auth.uid == driverId ||
        request.auth.token.email == driverId ||
        request.resource.data.driverId == driverId ||
        isAdmin()
      ) && isValidLatLng(request.resource.data.latitude, request.resource.data.longitude);

      // Delete allowed by the driver or admin upon going offline
      allow delete: if isAuthenticated() && (
        request.auth.uid == driverId ||
        request.auth.token.email == driverId ||
        isAdmin()
      );
    }

    // ---------------------------------------------------------
    // 3. DRIVER ONBOARDINGS (Driver Applications & Verification)
    // ---------------------------------------------------------
    match /driver_onboardings/{driverId} {
      // Driver can read their own onboarding submission; admins can review all
      allow read: if isAuthenticated() && (
        request.auth.uid == driverId ||
        request.auth.token.email == driverId ||
        isAdmin()
      );

      // Any authenticated user can submit a driver application
      allow create: if isAuthenticated() &&
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.vehiclePlate is string &&
        (request.resource.data.approvalStatus == 'PENDING' || isAdmin());

      // Only Admins can approve/reject; Driver can update contact info while pending
      allow update: if isAdmin() || (
        (request.auth.uid == driverId || request.auth.token.email == driverId) &&
        resource.data.approvalStatus == 'PENDING'
      );

      // Only Admins can delete driver applications
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 4. TRIPS HISTORY (Completed Trips & Invoices)
    // ---------------------------------------------------------
    match /trips_history/{tripId} {
      // Allowed for passenger, driver, or admin
      allow read: if isAuthenticated() && (
        resource.data.passengerName == request.auth.token.name ||
        resource.data.driverId == request.auth.uid ||
        resource.data.driverId == request.auth.token.email ||
        isAdmin()
      );

      // Created when a ride is completed or archived
      allow create: if isAuthenticated() &&
        request.resource.data.id != null &&
        request.resource.data.fareGmd is int &&
        (request.resource.data.status in ['COMPLETED', 'CANCELLED', 'IN_PROGRESS', 'REQUESTED', 'ACCEPTED', 'ARRIVED', 'EN_ROUTE']);

      // Passenger can update rating/review/tip; Admin has full update access
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewComment', 'reviewTags', 'tipGmd']))
      );

      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 5. TRIP RATINGS (Passenger Reviews & Feedback)
    // ---------------------------------------------------------
    match /trip_ratings/{ratingId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1.0 &&
        request.resource.data.rating <= 5.0;

      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 6. TRIP CHATS (In-Ride Passenger-Driver Secure Messaging)
    // ---------------------------------------------------------
    match /trip_chats/{tripId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        // Participants or Admin can read chat messages
        allow read: if isAuthenticated();

        // Sender can write their own messages
        allow create: if isAuthenticated() &&
          request.resource.data.message is string &&
          request.resource.data.message.size() > 0 &&
          request.resource.data.message.size() <= 1000;

        allow update: if isAuthenticated() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) ||
          isAdmin()
        );

        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------
    // 7. USER PROFILES & AUDIT LOGS
    // ---------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated() && (isUser(userId) || isAdmin());
      allow write: if isAuthenticated() && (isUser(userId) || isAdmin());
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
